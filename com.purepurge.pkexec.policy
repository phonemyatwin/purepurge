<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  PurePurge – Polkit policy
  =========================
  Grants pkexec the authority to run PurePurge purge scripts as root.
  Without this policy file, pkexec will refuse to execute the temp scripts
  generated by core/purger.py.

  Install to:  /usr/share/polkit-1/actions/com.purepurge.pkexec.policy
-->
<policyconfig>

  <vendor>PurePurge</vendor>
  <vendor_url>https://github.com/purepurge/purepurge</vendor_url>
  <icon_name>edit-delete</icon_name>

  <!-- ── Primary action: run a PurePurge purge script ──────────────── -->
  <action id="com.purepurge.pkexec.purge">
    <description>Run a PurePurge removal script</description>
    <description xml:lang="en">
      Authentication is required to remove packages and scrub residual
      files via PurePurge.
    </description>
    <message>PurePurge needs administrator privileges to remove packages.</message>
    <message xml:lang="en">
      PurePurge needs administrator privileges to remove packages and
      clean residual configuration files.
    </message>

    <defaults>
      <!-- Inactive console session (e.g. SSH) – require admin auth -->
      <allow_any>auth_admin</allow_any>
      <!-- Active local console – require admin auth (password prompt) -->
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>

    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/bash</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
